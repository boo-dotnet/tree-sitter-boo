# Runs the CI checks in a container, so a local run matches the workflow
# without a Node or compiler install on the host.
FROM node:slim

# gcc builds src/parser.c and src/scanner.c. git is for the drift check and for
# cloning the compiler corpus.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends gcc libc6-dev git \
	&& rm -rf /var/lib/apt/lists/*

WORKDIR /work

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

CMD ["scripts/ci.sh"]
