# Runs the CI checks in a container, so a local run needs no Node or compiler
# on the host.
FROM alpine:3

# tree-sitter-cli comes from apk because the published npm binaries are linked
# against glibc. node stays because tree-sitter generate evaluates grammar.js.
RUN apk add --no-cache bash git gcc musl-dev nodejs tree-sitter-cli

ENV TREE_SITTER=tree-sitter

WORKDIR /work
COPY . .

CMD ["scripts/ci.sh"]
